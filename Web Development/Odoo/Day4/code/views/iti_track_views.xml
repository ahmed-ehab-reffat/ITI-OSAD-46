<odoo>
    <data>

         <record id = 'iti_track_form_view' model ='ir.ui.view'>
            <field name='name'> ITI Track Form View </field>
            <field name='model'>iti.track</field>
            <field name='arch' type='xml'>
                <form>
                    <sheet>
                            <group string='Data'>
                                <field name='track_name' required = 'True'/>
                                <field name='capacity'/>
                                <field name='is_opened'/>
                                <field name='student_ids'>
                                     <list>
                                        <field name='name'/>
                                        <field name='is_accepted'/>
                                     </list>
                                </field>
                            </group>
                           
                    </sheet>
                </form>
            </field>
        </record>


        <record id = 'iti_track_action' model='ir.actions.act_window'>
            <field name = 'name'> Track Data </field>
            <field name='res_model'>iti.track</field>
            <field name='view_mode'>list,form</field>
        </record>

        <menuitem name ='Tracks' id = 'iti_track_menu' parent = 'iti_menu' sequence= '1' action = 'iti_track_action'/>
    </data>
</odoo>