<odoo>
    <data>

        <record id = 'iti_student_list_view' model ='ir.ui.view'>
            <field name='name'> ITI Student List View </field>
            <field name='model'>iti.student</field>
            <field name='arch' type='xml'>
                <list>
                    <field name='name'/>
                    <field name='age'/>
                    <field name='gender'/>
                </list>
            </field>
        </record> 


        <record id = 'iti_student_form_view' model ='ir.ui.view'>
            <field name='name'> ITI Student Form View </field>
            <field name='model'>iti.student</field>
            <field name='arch' type='xml'>
                <form>
                       <header>
                            <button name = 'accept_student' string = 'Accept Student' type='object'/>
                            <button name = 'check_level' string = 'Upgrade Level' type='object'/>

                            <field name='level' widget ='statusbar' nolabel='1' options="{'clickable' : '1'}"/>
                        </header>
                    <sheet>
                        <group>
                            <group string='General Information'>
                                <field name='name'/>
                                <field name='age'/>
                                <field name='gender'/>
                                <field name='birth_date'/>
                                <!-- <field name= 'level'/> -->
                            </group>
                            <group string='Working Information'>
                                <field name='is_accepted'/>
                                <!-- <field name='is_working' invisible = '1'/> -->
                                <field name='is_working'/>
                                <field name='cv' required = 'is_working==True'/>
                                <field name='salary' invisible = 'is_working==False'/>
                            </group>
                        </group>
                        <notebook>
                            <page name='track_data' string='Track Data'>
                                <group>
                                    <field name='track_id' domain = "[('is_opened' , '=' , True)]"/>
                                    <field name='track_capacity'/>
                                </group>
                            </page>
                             <page name='additional_data' string='Aditional Data'>
                                 <group>
                                    <field name='is_accepted'/>
                                    <field name='cv'/>
                                    <field name='salary'/>
                            </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>



        <record id = 'iti_student_action' model='ir.actions.act_window'>
            <field name = 'name'> Student Data </field>
            <field name='res_model'>iti.student</field>
            <field name='view_mode'>list,form,kanban</field>
        </record>

        <menuitem name = 'ITI' id = 'iti_menu'/>
        <menuitem name ='Students' id = 'iti_student_menu' sequence = '2' parent = 'iti_menu' action = 'iti_student_action'/>
    </data>
</odoo>